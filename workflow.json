        96
      ],
      "id": "6cb8669a-c055-47ec-ba46-9f960dfa6c85",
      "name": "\tValidate - Barcode Is Numeric",
      "notes": "Regex ^[0-9]+$"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"error\": \"El código de barras no es válido.\",\n  \"message\": \"El campo 'barcode' debe contener solo números.\",\n  \"example\": { \"barcode\": \"3017620422003\" }\n}\n",
        "options": {
          "responseCode": 400
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
