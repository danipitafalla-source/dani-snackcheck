        0
      ],
      "id": "3dd68918-cd70-4d7b-801b-741e05925b4c",
      "name": "Validate - Product Found",
      "notes": "Comprueba status === 1 de la respuesta"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"error\": \"Producto no encontrado.\",\n  \"message\": \"No se encontró ningún producto con ese código de barras en Open Food Facts.\",\n  \"example\": { \"barcode\": \"3017620422003\" }\n}\n",
        "options": {
          "responseCode": 404
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
