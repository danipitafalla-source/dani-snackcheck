      "id": "8b7fac7a-2588-4896-8345-5d40be254b9d",
      "name": "\tValidate - Barcode Not Empty",
      "notes": "\tSi falta el barcode, responde con instrucciones de uso"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"message\": \"Bienvenido a SnackCheck. Envía un código de barras para saber si un producto es saludable.\",\n  \"how_to_use\": {\n    \"method\": \"POST\",\n    \"body_example\": { \"barcode\": \"3017620422003\" }\n  }\n}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        448,
        -96
      ],
      "id": "30fd84ee-f271-4549-a609-85ebbb5a1575",
      "name": "Respond - Welcome Docs",
      "notes": "JSON autoexplicativo, 200"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "021c94f0-1d8f-497a-b3a6-7d1bf2ef239c",
              "leftValue": "={{ $json.body.barcode }}",
              "rightValue": "^[0-9]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
